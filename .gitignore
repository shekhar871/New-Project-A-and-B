# Python — never commit bytecode (rebuilt locally; bloats diffs)
__pycache__/
*.py[cod]
.$py.class

.env
data/training_started_at
.mplconfig/
# Embedding cache (R06)
data/offline_embeddings.npy
data/offline_embeddings.sha256
# Large/ephemeral training outputs
checkpoints/

# Keep repo clean but allow committed evidence artifacts:
runs/*
!runs/training_metrics.jsonl

results/*
!results/training_curve.png
!results/baseline_rollout.txt
!results/before_after.json
!results/training_attempt.log
